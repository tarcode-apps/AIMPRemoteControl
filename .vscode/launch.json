{
    "version": "0.2.0",
    "configurations": [
        {
            // The plugin DLL cannot run on its own: start AIMP and debug the
            // plugin inside it. The preLaunchTask (deploy-windows.ps1) links
            // AIMP's Plugins folder at the Debug build; the .pdb next to the
            // DLL makes breakpoints bind. A player elsewhere needs its path here.
            "name": "AIMP (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "C:\\Program Files\\AIMP\\AIMP.exe",
            "cwd": "C:\\Program Files\\AIMP",
            "preLaunchTask": "Deploy to AIMP (Debug)"
        },
        {
            // Debugs the Linux AIMP under gdb inside WSL (needs gdb installed
            // there: sudo apt-get install -y gdb). The preLaunchTask
            // (deploy-wsl.ps1) links /opt/aimp/Plugins at the Debug build.
            "name": "AIMP (WSL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/aimp",
            "cwd": "/opt/aimp",
            "MIMode": "gdb",
            "pipeTransport": {
                "pipeProgram": "wsl.exe",
                "pipeArgs": ["-e"],
                "debuggerPath": "/usr/bin/gdb",
                "pipeCwd": ""
            },
            // gdb reports sources as /mnt/<drive>/... — map them back to the
            // Windows checkout so breakpoints bind wherever the repo lives.
            "sourceFileMap": {
                "/mnt/c": "c:\\",
                "/mnt/d": "d:\\"
            },
            "preLaunchTask": "Deploy to WSL AIMP (Debug)"
        }
    ]
}
