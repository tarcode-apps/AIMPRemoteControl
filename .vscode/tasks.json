{
    "version": "2.0.0",
    "tasks": [
        {
            // Closes AIMP, links it at the build and builds Debug; the debugger
            // starts AIMP itself.
            "label": "Deploy to AIMP (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\plugin\\deploy-windows.ps1",
                "-Config",
                "Debug",
                "-NoStart"
            ],
            "problemMatcher": ["$msCompile"],
            "group": "build"
        },
        {
            // The same for the AIMP installed in WSL.
            "label": "Deploy to WSL AIMP (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\plugin\\deploy-wsl.ps1",
                "-Config",
                "Debug",
                "-NoStart"
            ],
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
