<?xml version="1.0" encoding="utf-8"?>
<!--
    What a backup of the app takes on Android 9 to 11: see data_extraction_rules.xml. One list serves the
    cloud and the transfer between devices here, so the passwords are named once for each.
-->
<full-backup-content>
    <include domain="file" path="datastore/players.json" />
    <include domain="file" path="datastore/passwords.json" requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/passwords.json" requireFlags="deviceToDeviceTransfer" />
    <include domain="root" path="app_webview" />
    <include domain="sharedpref" path="." />
</full-backup-content>
